node_modules/
.project_id
.github_repo
.env
.env.*

# Build output. CI builds this from src/ on every deploy, so committing it
# would mean the repo carries a stale copy that is not what ships.
.vercel/output/

# Capacitor copies the built web bundle in; it is regenerated by cap sync.
ios/App/App/public/
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/

# pdf.js's own font, cmap and wasm data, copied out of node_modules by
# scripts/pdfjs-assets.mjs at dev-server start and at the top of a build.
# 4MB of somebody else's binaries; npm has them pinned in the lockfile.
public/pdfjs/
