{
  "appId": "io.github.aminoulogie.soma",
  "appName": "SOMA",
  "webDir": ".vercel/output/static",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0b0c10"
  },
  "server": {
    "iosScheme": "capacitor"
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": false,
      "resetWhenUpdate": true,
      "appReadyTimeout": 15000,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "updateUrl": "",
      "statsUrl": "",
      "channelUrl": ""
    }
  }
}
